buntu-latest\n\n    steps:\n      - name: Checkout Private Source Code\n        uses: actions/checkout@v4\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v4\n        with:\n          node-version: '20'\n\n      - name: Install MyST and Staticrypt\n        run: npm install -g mystmd staticrypt\n\n      - name: Build MyST Site\n        env:\n          BASE_URL: /tambi-website/ # ⚠️ CHANGE THIS to match your public repo name!\n        run: myst build --html\n\n      - name: Scrub Source Files and Service Worker\n        run: |\n          echo \"Deleting Service Worker...\"\n          rm -f ./_build/html/service-worker.js\n\n          echo \"Finding and deleting source Markdown files...\"\n          find ./_build/html -name \"*.md\" -type f -print -delete\n\n          echo \"Finding and deleting Notebook files...\"\n          find ./_build/html -name \"*.ipynb\" -type f -print -delete\n\n          echo \"Verification — any .md files remaining?\"\n          REMAINING=$(find ./_build/html -name \"*.md\" -type f)\n          if [ -n \"$REMAINING\" ]; then\n            echo \"❌ WARNING: .md files still exist:\"\n            echo \"$REMAINING\"\n          else\n            echo \"✅ No .md files remaining.\"\n          fi\n\n      - name: Encrypt HTML Files\n        env:\n          STATICRYPT_PASSWORD: ${{ secrets.STATICRYPT_PASSWORD }}\n        run: |\n          if [ -z \"${STATICRYPT_PASSWORD}\" ]; then\n            echo \"❌ STATICRYPT_PASSWORD is EMPTY! Check your secret name.\"\n            exit 1\n          fi\n          echo \"✅ Password is set (length: ${#STATICRYPT_PASSWORD})\"\n\n          echo \"Starting encryption...\"\n          FAILED=0\n          while read -r file; do\n            # Create a unique temp directory for this file's output\n            TMPDIR=$(mktemp -d)\n\n            # Encrypt the file — output goes to $TMPDIR/<filename>\n            # Note: staticrypt v3 does not have an -o flag, must use -d\n            if ! staticrypt \"$file\" -p \"${STATICRYPT_PASSWORD}\" -d \"$TMPDIR\"; then\n              echo \"❌ staticrypt failed for: $file\"\n              FAILED=1\n              rm -rf \"$TMPDIR\"\n              continue\n            fi\n\n            # Find the encrypted output file\n            ENCRYPTED_FILE=\"$TMPDIR/$(basename \"$file\")\"\n\n            if [ -f \"$ENCRYPTED_FILE\" ]; then\n              # Overwrite the original with the encrypted version\n              cp \"$ENCRYPTED_FILE\" \"$file\"\n              echo \"✅ Encrypted: $file\"\n            else\n              echo \"❌ Encrypted file not found for: $file\"\n              FAILED=1\n            fi\n\n            rm -rf \"$TMPDIR\"\n          done < <(find ./_build/html -name \"*.html\")\n\n          if [ \"$FAILED\" -eq 1 ]; then\n            echo \"Encryption FAILED for one or more files.\"\n            exit 1\n          fi\n\n          echo \"Encryption complete.\"\n\n      - name: Final Verification Before Deploy\n        run: |\n          echo \"=== Checking for leaked source files ===\"\n          LEAKED=false\n\n          MD_FILES=$(find ./_build/html -name \"*.md\" -type f)\n          if [ -n \"$MD_FILES\" ]; then\n            echo \"❌ .md files found:\"\n            echo \"$MD_FILES\"\n            LEAKED=true\n          fi\n\n          IPYNB_FILES=$(find ./_build/html -name \"*.ipynb\" -type f)\n          if [ -n \"$IPYNB_FILES\" ]; then\n            echo \"❌ .ipynb files found:\"\n            echo \"$IPYNB_FILES\"\n            LEAKED=true\n          fi\n\n          if [ \"$LEAKED\" = true ]; then\n            echo \"❌ Source files would be leaked! Aborting deploy.\"\n            exit 1\n          else\n            echo \"✅ No source files found. Safe to deploy.\"\n          fi\n\n          echo \"=== Checking encryption ===\"\n          if head -n 5 ./_build/html/index.html | grep -qi \"staticrypt\"; then\n            echo \"✅ index.html is encrypted.\"\n          else\n            echo \"❌ index.html is NOT encrypted!\"\n            exit 1\n          fi\n\n      - name: Deploy to Public Repo\n        uses: peaceiris/actions-gh-pages@v3\n        with:\n          publish_dir: ./_build/html\n          external_repository: your-username/tambi-website # ⚠️ CHANGE THIS to your public repo!\n          publish_branch: main\n          personal_token: ${{ secrets.DEPLOY_TOKEN }}\n          force_orphan: true","position":{"start":{"line":48,"column":1},"end":{"line":186,"column":1}},"key":"e7ltdqosIP"},{"type":"list","ordered":true,"start":3,"spread":false,"position":{"start":{"line":188,"column":1},"end":{"line":192,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":188,"column":1},"end":{"line":190,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":188,"column":1},"end":{"line":188,"column":1}},"children":[{"type":"text","value":"⚠️ Make two changes in the file:","position":{"start":{"line":188,"column":1},"end":{"line":188,"column":1}},"key":"wiWfW6COR8"}],"key":"eHu5O8bJAR"}],"key":"oP2Fxf0Ji0"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":189,"column":1},"end":{"line":190,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":189,"column":1},"end":{"line":189,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Change ","position":{"start":{"line":189,"column":1},"end":{"line":189,"column":1}},"key":"ZsSRlZ7O7x"},{"type":"inlineCode","value":"BASE_URL: /tambi-website/","position":{"start":{"line":189,"column":1},"end":{"line":189,"column":1}},"key":"iQba6Ycbfk"},{"type":"text","value":" to match your public repository name (e.g., ","position":{"start":{"line":189,"column":1},"end":{"line":189,"column":1}},"key":"ZUFX8W4fpu"},{"type":"inlineCode","value":"/my-docs-site/","position":{"start":{"line":189,"column":1},"end":{"line":189,"column":1}},"key":"mWaJytM139"},{"type":"text","value":").","position":{"start":{"