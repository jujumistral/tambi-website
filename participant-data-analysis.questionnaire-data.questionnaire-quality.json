{"version":3,"kind":"Article","sha256":"6b303f47b87461a5b1ec7823606828c27c0cdcbaf91714ce406bfc7d5186deb7","slug":"participant-data-analysis.questionnaire-data.questionnaire-quality","location":"/participant_data_analysis/questionnaire_data/questionnaire_quality.md","dependencies":[],"frontmatter":{"title":"Questionnaire Response Quality","content_includes_title":false,"keywords":["Uncertainty","Quantification","Reinforcement Learning","Bayesian Inference","Active Inference"],"numbering":{"title":{"offset":2}},"thumbnail":"/tambi-website/_public/fig_totals_spearman-51a6c492517e0988d3b0be77d13236c2.png","exports":[{"format":"md","filename":"questionnaire_quality.md","url":"/tambi-website/_public/questionnaire_qualit-649ed437698726476f23bad5d7c9846a.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"This section checks how the questionnaires were answered, using the item-level LimeSurvey export rather than the scored totals. It covers the answers to the questions on the time window of each section, the agreement of the STICSA trait and state items, the interval between the questionnaire and the lab session, completion times, attention checks, uniform answers across a scale, the answer format of the Beck Depression Inventory-II (BDI-II), the reverse-keyed items of the Social Interaction Anxiety Scale (SIAS), internal consistency, and the distributions and correlations of the totals. All numbers refer to the 85 participants with behavioural and questionnaire data of run ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"lSq3Gin3SX"},{"type":"inlineCode","value":"13_11","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"IRTqyYRFux"},{"type":"text","value":" (None, 31; Partial, 33; Full, 21). Script ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"ke